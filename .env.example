# Server-only. Use a pooled Neon connection string in Vercel.
DATABASE_URL=

# Provisioned by Neon Auth. Never expose this value to browser code.
NEON_AUTH_BASE_URL=

# Generate at least 32 random bytes. Keep stable across deployments.
NEON_AUTH_COOKIE_SECRET=

# Comma-separated bootstrap administrators. Remove addresses no longer needed.
PORTAL_ADMIN_EMAILS=

# Canonical production URL. Preview deployments continue to use their Vercel URL.
NEXT_PUBLIC_APP_URL=https://app.moonriftmedia.com
APP_URL=https://app.moonriftmedia.com

# Optional server-only Google Apps Script webhook for payout mirroring.
GOOGLE_SHEETS_PAYOUT_WEBHOOK_URL=

# Calendly booking sync. All values are server-only and must never use a
# NEXT_PUBLIC_ prefix. The event type URI is the exact API URI for the event.
CALENDLY_ACCESS_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_WEBHOOK_SECRET=
GOOGLE_SHEETS_BOOKING_WEBHOOK_URL=

# Native Meta Ads OAuth. All credentials and tokens are server-only.
META_APP_ID=
META_APP_SECRET=
# Optional Facebook Login for Business configuration ID.
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v24.0
# Exactly 32 random bytes encoded as base64, or 64 hexadecimal characters.
META_TOKEN_ENCRYPTION_KEY=
# Long random value used by Vercel to authorize the daily sync route.
CRON_SECRET=
